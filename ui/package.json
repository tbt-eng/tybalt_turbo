{
  "name": "ui",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "copy-version": "cp ../version.json static/version.json",
    "dev": "npm run copy-version && vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:branch-flow": "node --test --experimental-strip-types tests/branchResourceFlow.test.ts",
    "test:branch-hours": "node --test --experimental-strip-types tests/branchHours.test.ts",
    "lint": "npm run -s check:ui && node scripts/check-docs-commit.mjs && prettier --check . && eslint .",
    "check:ui": "node scripts/check-ui.mjs && node scripts/check-docs-style.mjs && npm run -s test:docs",
    "format": "prettier --write .",
    "test:time-summary": "node --test --experimental-strip-types tests/timeSummary.test.ts",
    "test:time-summary-browser": "node tests/timeSummary.browser.mjs",
    "test:docs": "node --test --experimental-strip-types tests/docs.test.ts tests/docsSearch.test.ts tests/helpChat.test.ts tests/deployGroups.test.ts tests/helpChatStatus.test.ts",
    "test:help-chat-browser": "node tests/helpChat.browser.mjs",
    "test:app-config-browser": "node tests/appConfig.browser.mjs",
    "test:docs-search-browser": "node tests/docsSearch.browser.mjs",
    "test:docs-browser": "node tests/docsHelp.browser.mjs",
    "test:docs-nav-browser": "node tests/docsNav.browser.mjs",
    "test:help-bubble-browser": "node tests/helpBubble.browser.mjs",
    "test:wip": "node --test --experimental-strip-types tests/wip.test.ts",
    "test:local-date": "node --test --experimental-strip-types tests/localDate.test.ts",
    "test:wip-browser": "node tests/wip.browser.mjs",
    "test:po-approval-limits-browser": "node tests/poApprovalLimits.browser.mjs",
    "test:wip-reports": "node --test --experimental-strip-types tests/wipReports.test.ts",
    "test:wip-reports-browser": "node tests/wipReports.browser.mjs",
    "test:wip-links-login-browser": "node tests/wipLinksLogin.browser.mjs",
    "test:project-completion-date-browser": "node tests/projectCompletionDate.browser.mjs",
    "test:po-print": "node --test --experimental-strip-types tests/poPrint.test.ts",
    "test:po-group-csv": "node --test --experimental-strip-types tests/poGroupCsv.test.ts",
    "test:po-print-browser": "node tests/poPrint.browser.mjs",
    "test:job-requests": "node --test --experimental-strip-types tests/jobRequests.test.ts",
    "test:job-request-permissions": "node --experimental-vm-modules --test tests/jobRequestPermissions.test.mjs",
    "test:manager-allocations-browser": "node tests/managerAllocations.browser.mjs",
    "test:job-requests-browser": "node tests/projectRequests.browser.mjs",
    "test:job-request-review-browser": "node tests/jobRequestReview.browser.mjs",
    "test:job-value-navigation-browser": "node tests/jobValueNavigation.browser.mjs",
    "test:job-value-rejection-browser": "node tests/jobValueRejection.browser.mjs",
    "test:job-value-review-browser": "node tests/jobValueReview.browser.mjs",
    "test:client-workspace": "node --test --experimental-strip-types tests/clientWorkspace.test.ts tests/clientWorkflowNavigation.test.ts",
    "test:client-editors": "node --experimental-vm-modules --test tests/clientEditors.test.mjs",
    "test:client-editors-browser": "node tests/clientEditors.browser.mjs",
    "test:client-workspace-browser": "node tests/clientWorkspace.browser.mjs",
    "test:ds-list-browser": "node tests/dsList.browser.mjs",
    "test:job-billing-browser": "node tests/jobBilling.browser.mjs",
    "test:change-client-browser": "node tests/changeClient.browser.mjs",
    "test:close-project-browser": "node tests/closeProject.browser.mjs",
    "test:expense-tracking-browser": "node tests/expenseTracking.browser.mjs",
    "test:cumulative-po-currency-browser": "node tests/cumulativePOCurrency.browser.mjs",
    "test:timesheet-actions": "node --test --experimental-strip-types tests/timesheetActions.test.ts",
    "test:timesheet-share-browser": "node tests/timesheetShare.browser.mjs",
    "test:timesheet-rejected-browser": "node tests/timesheetRejected.browser.mjs",
    "test:tracking-help-browser": "node tests/trackingHelp.browser.mjs"
